generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeetingStatus {
  PROCESSING
  READY
  FAILED
}

enum SourceType {
  UPLOAD
}

enum JobType {
  EXTRACT_TEXT
  NORMALIZE_TRANSCRIPT
  SUMMARIZE_TRANSCRIPT
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
}

model Meeting {
  id               String        @id @default(uuid())
  title            String
  meetingDate      DateTime?
  tags             String?       // comma-separated
  status           MeetingStatus @default(PROCESSING)
  sourceType       SourceType    @default(UPLOAD)
  originalFilename String
  storedFilePath   String        // relative path under ./data/uploads
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  transcript Transcript?
  summaries  Summary[]
  jobs       Job[]

  @@index([status])
  @@index([createdAt])
}

model Transcript {
  id             String   @id @default(uuid())
  meetingId      String   @unique
  rawText        String   @db.Text // extracted text
  normalizedText String   @db.Text // cleaned/normalized text
  detectedFormat String   // txt|vtt|srt|docx|pdf
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Summary {
  id              String   @id @default(uuid())
  meetingId       String
  model           String
  promptVersion   String
  summaryJson     String   @db.Text // JSON string of structured summary
  summaryMarkdown String   @db.Text // Markdown formatted summary
  createdAt       DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([createdAt])
}

model Job {
  id        String    @id @default(uuid())
  meetingId String
  type      JobType
  status    JobStatus @default(QUEUED)
  attempts  Int       @default(0)
  lastError String?   @db.Text
  runAt     DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([meetingId])
}
