generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Note: SQLite doesn't support enums, so we use String fields with validation in code
// MeetingStatus: PROCESSING | READY | FAILED
// SourceType: UPLOAD
// JobType: EXTRACT_TEXT | NORMALIZE_TRANSCRIPT | SUMMARIZE_TRANSCRIPT
// JobStatus: QUEUED | RUNNING | SUCCESS | FAILED

model Meeting {
  id               String   @id @default(uuid())
  title            String
  meetingDate      DateTime?
  tags             String?       // comma-separated
  status           String   @default("PROCESSING") // PROCESSING | READY | FAILED
  sourceType       String   @default("UPLOAD")     // UPLOAD
  originalFilename String
  storedFilePath   String        // relative path under ./data/uploads
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transcript Transcript?
  summaries  Summary[]
  jobs       Job[]

  @@index([status])
  @@index([createdAt])
}

model Transcript {
  id             String   @id @default(uuid())
  meetingId      String   @unique
  rawText        String   // extracted text
  normalizedText String   // cleaned/normalized text
  detectedFormat String   // txt|vtt|srt|docx|pdf
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model Summary {
  id              String   @id @default(uuid())
  meetingId       String
  model           String
  promptVersion   String
  summaryJson     String   // JSON string of structured summary
  summaryMarkdown String   // Markdown formatted summary
  createdAt       DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([createdAt])
}

model Job {
  id        String   @id @default(uuid())
  meetingId String
  type      String   // EXTRACT_TEXT | NORMALIZE_TRANSCRIPT | SUMMARIZE_TRANSCRIPT
  status    String   @default("QUEUED") // QUEUED | RUNNING | SUCCESS | FAILED
  attempts  Int      @default(0)
  lastError String?
  runAt     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([meetingId])
}
